# Makes files created by Airflow inside the container owned by YOU on the host,
# instead of root. On Linux this should be your user id (run: id -u).
AIRFLOW_UID=1000

# Extra Python packages to install into the Airflow containers on startup.
# Used by the Phase 3 ETL project (pandas + requests). Leave as-is.
_PIP_ADDITIONAL_REQUIREMENTS=pandas requests
